# Copy this file to .env and fill in your own values. Never commit .env.
TINYFORGE_API_KEY=your-api-key
TINYFORGE_BASE_URL=https://api.openai.com/v1
TINYFORGE_MODEL=gpt-4o-mini

# Optional runtime limits
# TINYFORGE_MAX_ROUNDS=30
# TINYFORGE_TOOL_TIMEOUT=60
# TINYFORGE_MAX_TOOL_OUTPUT=30000
# TINYFORGE_MAX_CONTEXT_CHARS=150000
