# Copy this file to .env and fill in your own values. Never commit .env.
TINYFORGE_API_KEY=your-api-key
TINYFORGE_BASE_URL=https://api.openai.com/v1
TINYFORGE_MODEL=gpt-4o-mini
TINYFORGE_WIRE_API=chat_completions

# Responses API options
# TINYFORGE_REASONING_EFFORT=xhigh
# TINYFORGE_STORE_RESPONSES=false

# Optional runtime limits
# TINYFORGE_MAX_ROUNDS=30
# TINYFORGE_TOOL_TIMEOUT=60
# TINYFORGE_MAX_TOOL_OUTPUT=30000
# TINYFORGE_MAX_CONTEXT_CHARS=150000
# TINYFORGE_MAX_CONTEXT_TOKENS=30000
# TINYFORGE_MEMORY_ENABLED=true
# TINYFORGE_ARCHIVE_SESSIONS=true
# TINYFORGE_STATE_DIR=~/.tinyforge
